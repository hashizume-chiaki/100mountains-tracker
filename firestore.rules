rules_version = '2';
// Firebase コンソール → Firestore Database → ルール に、この内容をそのまま貼り付けて「公開」する。
service cloud.firestore {
  match /databases/{database}/documents {
    // 本人だけが読み書きできる記録
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 登頂済みの山だけの公開用コピー(Claude などの外部ツールが REST API で読む)
    // - URL を知っていれば誰でも1件ずつ読める(get)。一覧の取得(list)はできない
    // - 書き込めるのは本人だけ。中身はアプリが書くフィールドに限る
    match /publicProgress/{userId} {
      allow get: if true;
      allow list: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['version', 'updatedAt', 'total', 'climbedCount', 'climbed', 'climbedText', 'unclimbedText']);
    }
  }
}
